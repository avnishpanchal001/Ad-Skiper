{
  "manifest_version": 3,
  "name": "adskiper",
  "version": "2.3.0",
  "description": "Ultra-fast YouTube Ad Skipper with zero buffering delay. 100% Ad-Free, No VPN needed.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube.com./*",
    "*://*.googlesyndication.com/*",
    "*://*.doubleclick.net/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adskiper_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube.com./*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://*.youtube.com/*", "*://*.youtube.com./*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "adskiper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
